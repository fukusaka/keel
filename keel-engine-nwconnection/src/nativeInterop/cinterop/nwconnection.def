language = Objective-C
headers = Network/Network.h netinet/in.h dispatch/dispatch.h string.h Security/Security.h
linkerOpts = -framework Security

---

#include <Network/Network.h>
#include <netinet/in.h>
#include <sys/un.h>
#include <dispatch/dispatch.h>
#include <string.h>
#include <Security/Security.h>

/*
 * Applies user-supplied TCP options inside an nw_parameters configure block.
 *
 * Negative sentinel values (-1) mean "leave NW framework default" — mirrors
 * the `null` semantics of keel's SocketOptions typed properties. Only
 * TCP_NODELAY and SO_KEEPALIVE are expressible; NW framework does not
 * expose SO_RCVBUF / SO_SNDBUF (buffer sizing is managed internally).
 */
static void keel_nw_configure_tcp_options(nw_protocol_options_t tcp_options,
                                          int no_delay,
                                          int enable_keepalive) {
    if (no_delay >= 0) {
        nw_tcp_options_set_no_delay(tcp_options, no_delay ? true : false);
    }
    if (enable_keepalive >= 0) {
        nw_tcp_options_set_enable_keepalive(tcp_options, enable_keepalive ? true : false);
    }
}

/*
 * NW_PARAMETERS_DISABLE_PROTOCOL and NW_PARAMETERS_DEFAULT_CONFIGURATION are
 * C macros that cast extern block constants. They cannot be bound directly by
 * cinterop; this wrapper creates plain TCP parameters without TLS.
 */
/*
 * reuse_local_address: the documented Network.framework analogue of
 * SO_REUSEADDR, set on every listener parameter below. Best-effort only —
 * on the tested macOS, NWListener does NOT honour it when binding over a
 * local-port TIME_WAIT (it still fails EADDRINUSE), even though a POSIX
 * socket with SO_REUSEADDR or SO_REUSEPORT binds the identical state. So a
 * NWConnection server cannot immediately rebind a port whose prior
 * server-side connections linger in TIME_WAIT, unlike the POSIX engines.
 * A known Network.framework bug (Apple Radar FB8658821); the bind failure
 * now reports the errno (keel_nw_error_posix_code) for diagnosis.
 */
nw_parameters_t keel_nw_create_tcp_params(void) {
    nw_parameters_t params = nw_parameters_create_secure_tcp(
        NW_PARAMETERS_DISABLE_PROTOCOL,
        NW_PARAMETERS_DEFAULT_CONFIGURATION
    );
    if (params) nw_parameters_set_reuse_local_address(params, true);
    return params;
}

/*
 * Test helper: reads back the reuse_local_address flag (the SO_REUSEADDR
 * equivalent) the keel_nw_create_*params wrappers set, so a seam test can
 * pin that every listener parameter enables address reuse. Returns 1 when
 * set, 0 otherwise. (nw_parameters_get_reuse_local_address returns bool,
 * normalised to int for a stable cinterop signature.)
 */
int keel_nw_get_reuse_local_address(nw_parameters_t params) {
    return nw_parameters_get_reuse_local_address(params) ? 1 : 0;
}

/*
 * Extracts the POSIX errno from an nw_error (0 when null or non-POSIX
 * domain). Lets the listener / connection failure paths surface the real
 * kernel reason (e.g. EADDRINUSE) instead of an opaque "failed" state.
 */
int keel_nw_error_posix_code(nw_error_t error) {
    if (!error) return 0;
    return nw_error_get_error_code(error);
}

/*
 * Same as keel_nw_create_tcp_params() but applies TCP_NODELAY /
 * SO_KEEPALIVE from user-supplied SocketOptions. Pass -1 to leave the
 * framework default; 0/1 to set the option explicitly.
 */
nw_parameters_t keel_nw_create_tcp_params_with_options(int no_delay,
                                                       int enable_keepalive) {
    nw_parameters_t params = nw_parameters_create_secure_tcp(
        NW_PARAMETERS_DISABLE_PROTOCOL,
        ^(nw_protocol_options_t tcp_options) {
            keel_nw_configure_tcp_options(tcp_options, no_delay, enable_keepalive);
        }
    );
    if (params) nw_parameters_set_reuse_local_address(params, true);
    return params;
}

/*
 * TLS server parameters honouring the full TlsConfig — the server-side
 * upgrade for keel's NW engine. Wraps sec_protocol_options_* in the TLS
 * configure block:
 *
 *   * local identity                                       (always)
 *   * min / max TLS protocol version                       (when tls_min/tls_max != 0)
 *   * ALPN protocols                                       (when alpn_count > 0)
 *   * peer certificate authentication (mTLS)               (when require_peer_auth != 0)
 *     - with pinned trust anchors verified inside a
 *       sec_protocol_options_set_verify_block (SecTrustSetAnchorCertificates
 *       + SecTrustSetAnchorCertificatesOnly + SecTrustEvaluateWithError)
 *       (when ca_count > 0)
 *     - without an anchor list falls back to the system trust store, which
 *       is Apple's default behaviour when peer authentication is required
 *
 * Version enum values are the SecProtocolTypes.h `tls_protocol_version_t`
 * ordinals passed in as ints:
 *
 *   tls_protocol_version_TLSv12 = 0x0303
 *   tls_protocol_version_TLSv13 = 0x0304
 *
 * Passing `0` for tls_min / tls_max leaves the NW framework default in
 * place (the caller — the Kotlin side — always fills in a value from
 * TlsConfig.minVersion, so this null-sentinel is defensive).
 *
 * verify_block memory: the anchor CA CFDataRef / SecCertificateRef array
 * is materialised inside this function and captured by the outer TLS
 * options block as an `id` (toll-free bridged NSArray). Under MRR block
 * copy semantics the id capture is retained on `Block_copy` and released
 * on `Block_release`, so the array lives exactly as long as the block
 * does — which is until sec_protocol_options_t (and the params object
 * that owns it) is deallocated. The `CFRelease` at the end of this
 * function drops the +1 that `CFArrayCreateMutable` handed us, leaving
 * the block's own retain intact. The earlier `__block CFMutableArrayRef`
 * capture leaked that +1 because CoreFoundation types receive no
 * automatic retain/release treatment through `_Block_object_assign`
 * (`__block id` behaves differently under MRR — CF types are just plain
 * pointers to the block runtime).
 */
nw_parameters_t keel_nw_create_tls_tcp_params_full(sec_identity_t identity,
                                                    int tls_min,
                                                    int tls_max,
                                                    int require_peer_auth,
                                                    const char **alpn_list,
                                                    int alpn_count,
                                                    const uint8_t **ca_certs_der,
                                                    const uint32_t *ca_certs_lens,
                                                    int ca_count,
                                                    int no_delay,
                                                    int enable_keepalive) {
    if (!identity) return NULL;

    /* Materialise the pinned-CA anchors up front (once per listener),
     * so the verify block can just consult a captured array.
     *
     * Captured as `id` (not the raw CFMutableArrayRef) so the outer TLS
     * options block retains it during Block_copy under MRR — CF types get
     * no such treatment through block copy, so the previous captured
     * `CFMutableArrayRef` leaked the initial `CFArrayCreateMutable` +1
     * because there was nothing to balance it against. Bridging to `id`
     * lets `_Block_object_assign` retain the anchors on Block_copy and
     * release them again on Block_release, at which point we can drop
     * our own +1 with a plain `CFRelease` right after the params are
     * assembled. Toll-free bridging keeps the underlying object
     * (CFArray === NSArray) unchanged. */
    id anchors = nil;
    if (require_peer_auth && ca_count > 0 && ca_certs_der && ca_certs_lens) {
        CFMutableArrayRef cf_anchors = CFArrayCreateMutable(
            NULL, ca_count, &kCFTypeArrayCallBacks);
        if (cf_anchors) {
            for (int i = 0; i < ca_count; i++) {
                CFDataRef der = CFDataCreate(NULL, ca_certs_der[i], ca_certs_lens[i]);
                if (!der) continue;
                SecCertificateRef cert = SecCertificateCreateWithData(NULL, der);
                CFRelease(der);
                if (cert) {
                    CFArrayAppendValue(cf_anchors, cert);
                    CFRelease(cert);
                }
            }
            anchors = (__bridge id)cf_anchors;
        }
    }

    dispatch_queue_t verify_queue = dispatch_get_global_queue(QOS_CLASS_UTILITY, 0);

    nw_parameters_t params = nw_parameters_create_secure_tcp(
        ^(nw_protocol_options_t tls_options) {
            sec_protocol_options_t proto = nw_tls_copy_sec_protocol_options(tls_options);
            sec_protocol_options_set_local_identity(proto, identity);

            if (tls_min != 0) {
                sec_protocol_options_set_min_tls_protocol_version(
                    proto, (tls_protocol_version_t)tls_min);
            }
            if (tls_max != 0) {
                sec_protocol_options_set_max_tls_protocol_version(
                    proto, (tls_protocol_version_t)tls_max);
            }

            for (int i = 0; i < alpn_count; i++) {
                if (alpn_list[i]) {
                    sec_protocol_options_add_tls_application_protocol(
                        proto, alpn_list[i]);
                }
            }

            if (require_peer_auth) {
                sec_protocol_options_set_peer_authentication_required(proto, true);

                if (anchors) {
                    sec_protocol_options_set_verify_block(proto,
                        ^(sec_protocol_metadata_t metadata,
                          sec_trust_t sec_trust,
                          sec_protocol_verify_complete_t complete)
                        {
                            SecTrustRef trust = sec_trust_copy_ref(sec_trust);
                            if (!trust) { complete(false); return; }

                            /* Set the SSL policy explicitly to client-auth
                             * (server = false) with no hostname pin — the
                             * peer being verified here is the connecting
                             * TLS client, not a server, so the default SSL
                             * server-auth policy that NW installs would
                             * apply the wrong extended key usage checks
                             * (kSecPolicyAppleSSLServer vs SSLClient) and
                             * reject even a validly-signed client cert. */
                            SecPolicyRef clientPolicy = SecPolicyCreateSSL(false, NULL);
                            if (clientPolicy) {
                                CFMutableArrayRef policies = CFArrayCreateMutable(
                                    NULL, 1, &kCFTypeArrayCallBacks);
                                CFArrayAppendValue(policies, clientPolicy);
                                SecTrustSetPolicies(trust, policies);
                                CFRelease(policies);
                                CFRelease(clientPolicy);
                            }

                            /* Pin to caller-supplied anchors only — the
                             * system trust store must not be a source of
                             * TLS trust when TlsConfig.trustAnchors is a
                             * Pem list (keel's other backends behave the
                             * same way). */
                            SecTrustSetAnchorCertificates(trust, (__bridge CFArrayRef)anchors);
                            SecTrustSetAnchorCertificatesOnly(trust, true);

                            CFErrorRef err = NULL;
                            bool ok = SecTrustEvaluateWithError(trust, &err);
                            if (err) CFRelease(err);
                            CFRelease(trust);
                            complete(ok);
                        },
                        verify_queue);
                }
                /* No anchors: system trust store is used (Apple default),
                 * which matches keel's TlsTrustSource.SystemDefault
                 * semantics on other backends. No verify block needed. */
            }
        },
        ^(nw_protocol_options_t tcp_options) {
            keel_nw_configure_tcp_options(tcp_options, no_delay, enable_keepalive);
        }
    );
    if (params) nw_parameters_set_reuse_local_address(params, true);
    /* Drop our own +1 from CFArrayCreateMutable. Under MRR the outer TLS
     * options block copy above retained `anchors` as an `id` capture, so
     * the array stays live for the block's lifetime after this release
     * (Block_release will drop the block's retain when nw_parameters_t
     * tears down its options and the block along with it). If no
     * verify block was installed (peer_auth off, or ca_count == 0)
     * then `anchors` is nil and this is a no-op. */
    if (anchors) CFRelease((__bridge CFTypeRef)anchors);
    return params;
}

/*
 * Creates a SecKeyRef from DER-encoded private key data.
 *
 * Wraps SecKeyCreateWithData with the necessary CFDictionary attributes
 * (kSecAttrKeyType, kSecAttrKeyClass) which require CFDictionaryCreateMutable
 * — awkward to use from Kotlin/Native due to CFDictionaryKeyCallBacks struct
 * pointer requirements.
 *
 * @param key_der   DER-encoded private key (PKCS#1 for RSA, SEC 1 for EC).
 * @param key_len   Length of key_der in bytes.
 * @param key_type  0 = RSA (kSecAttrKeyTypeRSA), 1 = EC (kSecAttrKeyTypeECSECPrimeRandom).
 * @return SecKeyRef on success, NULL on failure.
 */
SecKeyRef keel_nw_create_private_key(const void *key_der, uint32_t key_len, int key_type) {
    CFDataRef data = CFDataCreate(NULL, key_der, key_len);
    if (!data) return NULL;

    CFMutableDictionaryRef attrs = CFDictionaryCreateMutable(NULL, 2,
        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
    CFDictionarySetValue(attrs, kSecAttrKeyType,
        key_type == 1 ? kSecAttrKeyTypeECSECPrimeRandom : kSecAttrKeyTypeRSA);
    CFDictionarySetValue(attrs, kSecAttrKeyClass, kSecAttrKeyClassPrivate);

    SecKeyRef key = SecKeyCreateWithData(data, attrs, NULL);
    CFRelease(attrs);
    CFRelease(data);
    return key;
}

/* 127.0.0.1 in network byte order */
uint32_t keel_nw_loopback_addr(void) { return htonl(INADDR_LOOPBACK); }

/*
 * Darwin sockaddr_un.sun_path limit including NUL terminator.
 * See <sys/un.h>: char sun_path[104].
 */
uint32_t keel_nw_unix_path_max(void) { return (uint32_t)sizeof(((struct sockaddr_un *)0)->sun_path); }

/*
 * Fills a sockaddr_un with AF_UNIX + NUL-terminated filesystem path.
 *
 * Returns 0 on success, -1 if path exceeds sun_path capacity (104 bytes
 * incl. NUL on Darwin).
 */
static int keel_nw_fill_sockaddr_un(struct sockaddr_un *out, const char *path) {
    size_t len = strlen(path);
    if (len + 1 > sizeof(out->sun_path)) return -1;
    memset(out, 0, sizeof(*out));
    out->sun_family = AF_UNIX;
    out->sun_len = (unsigned char)sizeof(*out);
    memcpy(out->sun_path, path, len);
    out->sun_path[len] = '\0';
    return 0;
}

/*
 * Creates an NWEndpoint bound to a filesystem Unix-domain socket path.
 *
 * Uses the documented public API nw_endpoint_create_address() with a
 * sockaddr_un — avoiding the SPI nw_endpoint_create_unix() symbol that
 * is exported since macOS 10.15 but not declared in public headers
 * (an App Store reviewer could flag SPI usage). sockaddr-based
 * endpoint construction has been public since macOS 10.14 / iOS 12.
 *
 * @param path  NUL-terminated filesystem path (<= 103 bytes + NUL on Darwin).
 * @return endpoint on success, NULL if path is too long or the framework
 *         rejects the input.
 */
nw_endpoint_t keel_nw_endpoint_create_unix(const char *path) {
    struct sockaddr_un sun;
    if (keel_nw_fill_sockaddr_un(&sun, path) != 0) return NULL;
    return nw_endpoint_create_address((const struct sockaddr *)&sun);
}

/*
 * Creates listener-bound TCP-over-UDS parameters.
 *
 * Sets requiredLocalEndpoint on plain TCP parameters so that nw_listener_create
 * (no-port variant) binds to the given UDS path rather than an IP port. This
 * matches the pattern documented by Apple DTS:
 *
 *   params.defaultProtocolStack.transportProtocol = NWProtocolTCP.Options()
 *   params.requiredLocalEndpoint = NWEndpoint.unix(path: ...)
 *
 * The endpoint is built from a sockaddr_un via the public
 * nw_endpoint_create_address() — see keel_nw_endpoint_create_unix above.
 *
 * @param path  Filesystem UDS path.
 * @return parameters on success, NULL if endpoint creation fails.
 */
nw_parameters_t keel_nw_create_tcp_params_unix_listener(const char *path) {
    nw_parameters_t params = nw_parameters_create_secure_tcp(
        NW_PARAMETERS_DISABLE_PROTOCOL,
        NW_PARAMETERS_DEFAULT_CONFIGURATION
    );
    if (!params) return NULL;
    nw_endpoint_t ep = keel_nw_endpoint_create_unix(path);
    if (!ep) return NULL;
    nw_parameters_set_local_endpoint(params, ep);
    return params;
}

/*
 * Same as keel_nw_create_tcp_params_unix_listener(path) but applies
 * TCP_NODELAY / SO_KEEPALIVE to the TCP configure block. Semantics:
 * NW framework propagates the listener's TCP options to accepted
 * connections, so this wrapper is the natural place for
 * BindConfig.childSocketOptions on the UDS path.
 */
nw_parameters_t keel_nw_create_tcp_params_unix_listener_with_options(const char *path,
                                                                     int no_delay,
                                                                     int enable_keepalive) {
    nw_parameters_t params = nw_parameters_create_secure_tcp(
        NW_PARAMETERS_DISABLE_PROTOCOL,
        ^(nw_protocol_options_t tcp_options) {
            keel_nw_configure_tcp_options(tcp_options, no_delay, enable_keepalive);
        }
    );
    if (!params) return NULL;
    nw_endpoint_t ep = keel_nw_endpoint_create_unix(path);
    if (!ep) return NULL;
    nw_parameters_set_local_endpoint(params, ep);
    return params;
}

/*
 * Callback types for async C wrappers.
 * Used by Kotlin/Native staticCFunction + StableRef to bridge
 * NWConnection's dispatch callbacks to coroutine continuations.
 */
/*
 * Read callback with a dual-path delivery:
 *
 * - **Zero-copy single-region** (production fast path): [zc_handle] is a
 *   retained, opaque dispatch_data_t handle and [zc_ptr] is a pointer
 *   directly into the framework-managed memory. Both remain valid until
 *   [keel_nw_dispatch_data_release] is called on the handle. [len] is
 *   the byte count available at [zc_ptr]. The pre-supplied [buf] in
 *   [keel_nw_read_async] is untouched and the caller must release it
 *   (typically back to the pool) since the bytes are in the
 *   framework-owned region instead.
 *
 * - **Multi-region copy** (rare fallback): [zc_handle] / [zc_ptr] are
 *   NULL. [len] bytes have been memcpy'd into the [buf] originally
 *   passed to [keel_nw_read_async]. Identical semantics to the
 *   pre-zero-copy implementation.
 *
 * The empirical loopback-TCP distribution measured during the NW
 * zero-copy investigation (2026-05-20) recorded 100% single-region
 * across 1500+ receives, but Apple's documented dispatch_data_t
 * contract does not guarantee single-region — so the fallback path
 * remains a first-class case (TLS framework / future protocol
 * additions / kernel version differences may produce multi-region).
 */
/*
 * Callback `error` / `result` carry the POSIX errno of the underlying
 * failure (0 = success), extracted via keel_nw_error_posix_code — not a
 * bare 0/1 boolean. This lets the Kotlin side surface the real reason
 * (e.g. ECONNREFUSED on connect, EPIPE on write) instead of an opaque
 * "failed", the same diagnostic gap that hid the TIME_WAIT bind limitation
 * for the listener path.
 * `keel_nw_start_callback.result` is 0 on ready and the errno (or -1 when
 * the failure carries no errno, e.g. a plain cancellation) on failure.
 */
typedef void (*keel_nw_read_callback)(void *zc_handle,
                                       const void *zc_ptr,
                                       uint32_t len,
                                       int is_complete,
                                       int error,
                                       void *ctx);
typedef void (*keel_nw_write_callback)(int error, void *ctx);
typedef void (*keel_nw_start_callback)(int result, void *ctx);

/*
 * Async read via NWConnection with single-region zero-copy fast path.
 *
 * Schedules nw_connection_receive and invokes the callback when data
 * arrives. The callback receives the data in one of two shapes:
 *
 * 1. **Single-region** (production hot path on loopback TCP): the
 *    dispatch_data_t is retained, an opaque handle is passed to the
 *    callback in [zc_handle] together with the region pointer in
 *    [zc_ptr]. The caller wraps [zc_ptr]/[len] as an IoBuf and
 *    invokes [keel_nw_dispatch_data_release] on [zc_handle] at
 *    refcount-zero. [buf] is left untouched.
 *
 * 2. **Multi-region** (fallback): the bytes are memcpy'd into [buf]
 *    region-by-region, and [zc_handle]/[zc_ptr] are NULL. The caller
 *    consumes the existing [buf] as before.
 *
 * The branch is decided by walking the dispatch_data_t once with
 * dispatch_data_apply to count regions; single-region (>99% on
 * loopback TCP per investigation 2026-05-20) returns after the first
 * iteration without any byte copy.
 *
 * @param conn     NWConnection to read from.
 * @param buf      Fallback destination buffer. Unused in the
 *                 single-region path; written into in the multi-region
 *                 path. The caller pre-allocates either way.
 * @param buf_len  Capacity of [buf]; also used as `maximum_length` for
 *                 nw_connection_receive.
 * @param callback Invoked on completion.
 * @param ctx      Opaque pointer passed to callback (StableRef to
 *                 continuation).
 */
/*
 * Per-content dispatch: handles a single dispatch_data_t returned by
 * nw_connection_receive (or a synthetic one supplied by tests).
 * Decides between single-region zero-copy and multi-region copy
 * fallback, then invokes [callback] with the appropriate parameters
 * (see [keel_nw_read_callback] for the dual-path semantics).
 *
 * Factored out so the branching logic can be exercised in isolation by
 * `keel_nw_test_dispatch_received` without standing up a real
 * NWConnection.
 */
static void keel_nw_dispatch_received(dispatch_data_t content,
                                       void *buf, uint32_t buf_len,
                                       int is_complete,
                                       int failed,
                                       keel_nw_read_callback callback,
                                       void *ctx) {
    if (failed || !content) {
        callback(NULL, NULL, 0, is_complete, failed, ctx);
        return;
    }
    /* Single pass: count regions and snapshot the first one. */
    __block uint32_t region_count = 0;
    __block const void *first_ptr = NULL;
    __block size_t first_size = 0;
    dispatch_data_apply(content,
        ^(dispatch_data_t region, size_t offset,
          const void *ptr, size_t size)
        {
            region_count++;
            if (region_count == 1) {
                first_ptr = ptr;
                first_size = size;
            }
            return (bool)true;
        });
    if (region_count == 1) {
        /* Zero-copy fast path: retain the parent dispatch_data_t so
         * the region pointer survives past this block. The caller
         * receives a +1 retain via __bridge_retained and must release
         * it through keel_nw_dispatch_data_release at IoBuf
         * refcount-zero. */
        void *zc_handle = (__bridge_retained void *)content;
        uint32_t len = (first_size > buf_len) ? buf_len : (uint32_t)first_size;
        callback(zc_handle, first_ptr, len, is_complete, 0, ctx);
        return;
    }
    /* Multi-region fallback: memcpy each region into the pre-supplied
     * buffer. Exercised when the framework hands us a non-contiguous
     * dispatch_data_t (rare on loopback TCP, may occur under TLS /
     * future protocols). */
    __block uint32_t copied = 0;
    dispatch_data_apply(content,
        ^(dispatch_data_t region, size_t offset,
          const void *ptr, size_t size)
        {
            if (copied + size > buf_len) {
                size = buf_len - copied;
            }
            memcpy((uint8_t *)buf + copied, ptr, size);
            copied += (uint32_t)size;
            return (bool)(copied < buf_len);
        });
    callback(NULL, NULL, copied, is_complete, 0, ctx);
}

void keel_nw_read_async(nw_connection_t conn,
                         void *buf, uint32_t buf_len,
                         keel_nw_read_callback callback, void *ctx) {
    nw_connection_receive(conn, 1, buf_len,
        ^(dispatch_data_t content, nw_content_context_t context,
          bool is_complete, nw_error_t error)
        {
            keel_nw_dispatch_received(content, buf, buf_len,
                is_complete ? 1 : 0, keel_nw_error_posix_code(error), callback, ctx);
        });
}

/*
 * Releases a dispatch_data_t handle previously returned via the
 * [keel_nw_read_callback]'s [zc_handle] parameter. After this call the
 * handle is invalid and any pointers obtained from the read callback
 * may be reused by the framework. Safe to call on a non-NULL handle
 * only; passing NULL is a no-op for symmetry with the fallback path.
 *
 * Implemented via __bridge_transfer so the ARC runtime drops the +1
 * retain installed by [keel_nw_read_async]'s single-region branch.
 */
void keel_nw_dispatch_data_release(void *zc_handle) {
    if (!zc_handle) return;
    dispatch_data_t data = (__bridge_transfer dispatch_data_t)zc_handle;
    (void)data;
}

/*
 * Async write via NWConnection.
 *
 * Creates a dispatch_data_t from the caller's buffer, sends it via
 * nw_connection_send, and invokes the callback on completion.
 * No blocking.
 *
 * dispatch_data_create copies buf by default (DISPATCH_DATA_DESTRUCTOR_DEFAULT).
 * The caller's NativeBuf stays valid because flush() holds a retain.
 *
 * @param conn     NWConnection to write to.
 * @param buf      Source buffer.
 * @param buf_len  Number of bytes to send.
 * @param callback Invoked on completion with (error, ctx).
 * @param ctx      Opaque pointer passed to callback (StableRef to continuation).
 */
void keel_nw_write_async(nw_connection_t conn,
                          const void *buf, uint32_t buf_len,
                          keel_nw_write_callback callback, void *ctx) {
    dispatch_data_t data = dispatch_data_create(buf, buf_len,
        dispatch_get_global_queue(0, 0), DISPATCH_DATA_DESTRUCTOR_DEFAULT);

    nw_connection_send(conn, data, NW_CONNECTION_DEFAULT_MESSAGE_CONTEXT, false,
        ^(nw_error_t error) {
            callback(keel_nw_error_posix_code(error), ctx);
        });
}

/*
 * Batched async write via NWConnection (scatter/gather equivalent).
 *
 * Concatenates multiple buffers into a single dispatch_data_t using
 * dispatch_data_create_concat, then sends the combined data in one
 * nw_connection_send call. This is the NWConnection equivalent of
 * POSIX writev().
 *
 * Each buffer is copied into dispatch_data_t
 * (DISPATCH_DATA_DESTRUCTOR_DEFAULT). The concatenation itself is
 * zero-copy (dispatch_data_t chains internally without memcpy).
 *
 * @param conn       NWConnection to write to.
 * @param bufs       Array of source buffer pointers.
 * @param lens       Array of buffer lengths (bytes).
 * @param count      Number of buffers.
 * @param callback   Invoked on completion with (error, ctx).
 * @param ctx        Opaque pointer passed to callback.
 */
void keel_nw_writev_async(nw_connection_t conn,
                           const void **bufs, const uint32_t *lens, int count,
                           keel_nw_write_callback callback, void *ctx) {
    dispatch_data_t combined = dispatch_data_empty;
    dispatch_queue_t q = dispatch_get_global_queue(0, 0);
    for (int i = 0; i < count; i++) {
        dispatch_data_t chunk = dispatch_data_create(bufs[i], lens[i],
            q, DISPATCH_DATA_DESTRUCTOR_DEFAULT);
        dispatch_data_t prev = combined;
        combined = dispatch_data_create_concat(prev, chunk);
    }
    nw_connection_send(conn, combined, NW_CONNECTION_DEFAULT_MESSAGE_CONTEXT, false,
        ^(nw_error_t error) {
            callback(keel_nw_error_posix_code(error), ctx);
        });
}

/*
 * Send TCP FIN (half-close) via NWConnection.
 *
 * Sends NULL content with NW_CONNECTION_FINAL_MESSAGE_CONTEXT and
 * is_complete=true, which triggers a TCP FIN to the peer.
 * The read side remains open.
 *
 * Fire-and-forget: no callback needed because the caller does not
 * depend on shutdown completion (unlike flush).
 */
void keel_nw_shutdown_output(nw_connection_t conn) {
    nw_connection_send(conn, NULL, NW_CONNECTION_FINAL_MESSAGE_CONTEXT, true,
        ^(nw_error_t error) {
            /* Intentionally ignored: a half-close FIN is best-effort on an
             * already-closing connection. Any send error here means the
             * peer is gone, which the read side surfaces as a close — there
             * is no caller waiting on this completion to act on the errno. */
        });
}

/*
 * Start a connection asynchronously and invoke callback when ready.
 *
 * Sets a state handler on the connection, calls nw_connection_start,
 * and invokes the callback when the connection reaches ready or fails.
 * No blocking.
 *
 * @param conn     NWConnection to start.
 * @param queue    Dispatch queue for the connection's callbacks.
 * @param callback Invoked with 0 on ready, or the POSIX errno (or -1 when
 *                 the failure carries no errno) on failure / cancellation.
 * @param ctx      Opaque pointer passed to callback (StableRef to continuation).
 */
void keel_nw_start_conn_async(nw_connection_t conn, dispatch_queue_t queue,
                               keel_nw_start_callback callback, void *ctx) {
    /* Guard: state handler may fire multiple times (e.g. ready then cancelled).
     * The callback must be invoked exactly once to avoid double-resume of
     * the Kotlin coroutine continuation. */
    __block int called = 0;
    nw_connection_set_queue(conn, queue);
    nw_connection_set_state_changed_handler(conn,
        ^(nw_connection_state_t state, nw_error_t error) {
            if (called) return;
            if (state == nw_connection_state_ready) {
                called = 1;
                callback(0, ctx);
            } else if (state == nw_connection_state_failed ||
                       state == nw_connection_state_cancelled) {
                called = 1;
                /* Carry the connect errno (e.g. ECONNREFUSED) when present;
                 * fall back to -1 for an errno-less cancellation so failure
                 * always stays non-zero. */
                int ec = keel_nw_error_posix_code(error);
                callback(ec != 0 ? ec : -1, ctx);
            }
        });
    nw_connection_start(conn);
}

/*
 * --- Test-only helpers for verifying the production dual-path
 *     dispatch logic in [keel_nw_dispatch_received] without standing
 *     up a real NWConnection. ---
 */

/*
 * Creates a 2-region dispatch_data_t by concatenating two separately-
 * created chunks, then drives [keel_nw_dispatch_received] with it.
 * The synthetic data uses DISPATCH_DATA_DESTRUCTOR_DEFAULT, so the
 * bytes are copied at creation; framework-managed memory is not
 * involved. After return, the synthetic dispatch_data_t is released
 * (ARC drops the local reference); the zc_handle delivered to the
 * callback retains a separate +1 that the caller must release through
 * [keel_nw_dispatch_data_release] like in production.
 *
 * Used by `NwReadDualPathTest` to exercise the multi-region copy
 * fallback branch — that branch is unreachable through the loopback
 * test pattern because the NW framework empirically coalesces TCP
 * receive buffers into single-region dispatch_data_t (verified by the
 * region-count histogram investigation, 2026-05-20).
 */
void keel_nw_test_dispatch_concat(const void *bytes1, uint32_t len1,
                                    const void *bytes2, uint32_t len2,
                                    void *buf, uint32_t buf_len,
                                    int is_complete,
                                    keel_nw_read_callback callback,
                                    void *ctx) {
    dispatch_queue_t q = dispatch_get_global_queue(0, 0);
    dispatch_data_t d1 = dispatch_data_create(bytes1, len1, q,
        DISPATCH_DATA_DESTRUCTOR_DEFAULT);
    dispatch_data_t d2 = dispatch_data_create(bytes2, len2, q,
        DISPATCH_DATA_DESTRUCTOR_DEFAULT);
    dispatch_data_t combined = dispatch_data_create_concat(d1, d2);
    keel_nw_dispatch_received(combined, buf, buf_len,
        is_complete, 0, callback, ctx);
    /* ARC drops d1 / d2 / combined here; the zc_handle path's
     * __bridge_retained gave the callback its own +1 retain. */
}

/*
 * Drives [keel_nw_dispatch_received] with a single-region
 * dispatch_data_t built from the supplied bytes. Verifies the
 * zero-copy fast path: the callback receives a non-NULL zc_handle and
 * a pointer that survives past this call until
 * [keel_nw_dispatch_data_release] is invoked.
 */
void keel_nw_test_dispatch_single(const void *bytes, uint32_t len,
                                    void *buf, uint32_t buf_len,
                                    int is_complete,
                                    keel_nw_read_callback callback,
                                    void *ctx) {
    dispatch_data_t d = dispatch_data_create(bytes, len,
        dispatch_get_global_queue(0, 0), DISPATCH_DATA_DESTRUCTOR_DEFAULT);
    keel_nw_dispatch_received(d, buf, buf_len, is_complete, 0, callback, ctx);
}

/*
 * --- Investigation bench helpers (kept for future re-validation) ---
 *
 * These functions support the in-process micro-bench
 * `runNwRecvCostBench` in the `benchmark` module — they let the
 * benchmark create a `dispatch_data_t` once and drive [keel_nw_dispatch_received]
 * (or a copy-only variant) on the SAME handle many times to amortise
 * dispatch_data_t creation cost out of the per-iter measurement.
 *
 * Not used by production code paths (engine read path
 * [keel_nw_read_async] receives its `dispatch_data_t` from the
 * framework). KDoc'd here so future readers can find them when
 * re-validating the design decisions captured in
 * `benchmark/results-summary/2026-05-20-nw-zerocopy-recv-ab.md`.
 */

/*
 * Creates a single-region `dispatch_data_t` from [bytes] of length
 * [len] (via `dispatch_data_create` with the default destructor —
 * bytes are copied into framework-managed memory at creation). Returns
 * an opaque, retained handle suitable for [keel_nw_test_dispatch_handle]
 * + [keel_nw_dispatch_data_release].
 */
void *keel_nw_test_make_data_single(const void *bytes, uint32_t len) {
    dispatch_data_t d = dispatch_data_create(bytes, len,
        dispatch_get_global_queue(0, 0), DISPATCH_DATA_DESTRUCTOR_DEFAULT);
    return (__bridge_retained void *)d;
}

/*
 * Drives [keel_nw_dispatch_received] with a caller-provided opaque
 * `dispatch_data_t` handle (typically obtained from
 * [keel_nw_test_make_data_single]). The handle is *borrowed* — the
 * caller retains ownership and must release it via
 * [keel_nw_dispatch_data_release] when done. The single-region branch
 * inside [keel_nw_dispatch_received] takes its own +1 retain via
 * `__bridge_retained` and exposes that as the `zc_handle` callback
 * argument, so the wrap path's lifetime stays correct even with a
 * borrowed input handle.
 */
void keel_nw_test_dispatch_handle(void *handle,
                                    void *buf, uint32_t buf_len,
                                    int is_complete,
                                    keel_nw_read_callback callback,
                                    void *ctx) {
    dispatch_data_t d = (__bridge dispatch_data_t)handle;
    keel_nw_dispatch_received(d, buf, buf_len, is_complete, 0, callback, ctx);
}

/*
 * Forces the multi-region copy path on a single-region handle.
 *
 * This is the "always memcpy" baseline against which the dual-path
 * zero-copy implementation is compared. Bypasses [keel_nw_dispatch_received]
 * entirely and inlines the memcpy loop that the multi-region branch
 * uses, so that the caller's callback receives `zc_handle == NULL` +
 * `len` bytes in [buf] regardless of the actual region count.
 *
 * Production [keel_nw_read_async] never calls this — it is bench-only.
 */
void keel_nw_test_dispatch_handle_copyonly(void *handle,
                                             void *buf, uint32_t buf_len,
                                             int is_complete,
                                             keel_nw_read_callback callback,
                                             void *ctx) {
    dispatch_data_t d = (__bridge dispatch_data_t)handle;
    __block uint32_t copied = 0;
    dispatch_data_apply(d,
        ^(dispatch_data_t region, size_t offset,
          const void *ptr, size_t size)
        {
            if (copied + size > buf_len) {
                size = buf_len - copied;
            }
            memcpy((uint8_t *)buf + copied, ptr, size);
            copied += (uint32_t)size;
            return (bool)(copied < buf_len);
        });
    callback(NULL, NULL, copied, is_complete, 0, ctx);
}
