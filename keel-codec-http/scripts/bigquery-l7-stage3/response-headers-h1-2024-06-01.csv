query_1,"SELECT      product_id,     product_name AS url_title,     product_name AS product_name,     product_descrp AS product_descrp, 	product_price_DOLAR as product_price_usd, 	product_lastPrice_DOLAR as product_old_price_usd,	     product_lastPrice as product_old_price,     product_price,     product_discountimg_id,     discountimg_url,     discountimg_name,     discountimg_belongTo,      	               product_treeNew,     product_makat, 	 	product_isAvailable, 	product_units, 	product_delivery, 		 	 	product_upgradesGroup,				    	product_mutag,     product_achrayut,product_tashlumim,  product_supplyDays,     product_VAT,product_price_DOLAR,product_price_EUR,     product_pic1,product_picAlt1,product_pic2, product_picAlt2, product_pic3, product_picAlt3       FROM yalla_shops_products LEFT JOIN yalla_shops_discounts_img ON product_discountimg_id != 0 AND discountimg_id = product_discountimg_id WHERE product_belongTo = '10760' AND product_isActive = 'yes'  AND( product_id = '803169'  OR  product_id = '808470'  OR  product_id = '800229'  OR  product_id = '816428'  OR  product_id = '757987'  OR  product_id = '816442'  OR  product_id = '816441' ) ORDER BY case product_id  when '803169' then 1  when '808470' then 2  when '800229' then 3  when '816428' then 4  when '757987' then 5  when '816442' then 6  when '816441' then 7  else 8 end LIMIT 1000",1,4,25.0
