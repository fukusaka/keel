headers = sys/socket.h netinet/in.h arpa/inet.h sys/uio.h sys/time.h unistd.h string.h sys/un.h stddef.h errno.h limits.h
---
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <sys/uio.h>
#include <sys/time.h>
#include <unistd.h>
#include <string.h>
#include <sys/un.h>
#include <stddef.h>
#include <errno.h>
#include <limits.h>

/* htons/ntohs/htonl are macros — cinterop cannot bind them directly. */
static inline uint16_t keel_htons(uint16_t hostshort) { return htons(hostshort); }
static inline uint16_t keel_ntohs(uint16_t netshort)  { return ntohs(netshort);  }
static inline uint32_t keel_htonl(uint32_t hostlong)  { return htonl(hostlong);  }

/* INADDR_LOOPBACK is a macro — expose as a function for cinterop. */
static inline uint32_t keel_loopback_addr(void) { return htonl(INADDR_LOOPBACK); }

/*
 * Initialize sockaddr_in for IPv4.
 *
 * sin_family type differs across platforms (UShort on Linux, UByte on macOS),
 * causing Kotlin/Native commonization errors when AF_INET.convert() is used
 * in nativeMain. This C wrapper avoids the platform-specific type issue.
 */
static inline void keel_init_sockaddr_in(struct sockaddr_in *addr, uint16_t port) {
    memset(addr, 0, sizeof(*addr));
    addr->sin_family = AF_INET;
    addr->sin_port = htons(port);
}

/*
 * inet_pton/inet_ntop wrappers.
 *
 * Standard POSIX API available on both Linux and macOS via <arpa/inet.h>.
 * Wrapped because cinterop binding of inet_pton/inet_ntop is unreliable
 * on some Linux cross-compilation configurations.
 */
static inline int keel_inet_pton(int af, const char *src, void *dst) {
    return inet_pton(af, src, dst);
}
static inline const char *keel_inet_ntop(int af, const void *src, char *dst, unsigned int size) {
    return inet_ntop(af, src, dst, (socklen_t)size);
}

/*
 * IPv6 sockaddr helpers.
 *
 * sockaddr_in6.sin6_addr is a union whose field name differs across platforms
 * (Linux glibc: __in6_u.__u6_addr8 / macOS: __u6_addr.__u6_addr8), so accessing
 * it directly from Kotlin/Native cinterop is not portable. These wrappers use
 * memcpy on the union's first 16 bytes, which is a POSIX-guaranteed layout.
 *
 * `keel_init_sockaddr_in6` zeros the struct, sets AF_INET6, port (network
 * order) and scope id. Call `keel_fill_sockaddr_in6_addr` afterwards to load
 * the 16-byte address.
 */
static inline void keel_init_sockaddr_in6(struct sockaddr_in6 *addr, uint16_t port, uint32_t scope) {
    memset(addr, 0, sizeof(*addr));
    addr->sin6_family = AF_INET6;
    addr->sin6_port = htons(port);
    addr->sin6_scope_id = scope;
}

static inline void keel_fill_sockaddr_in6_addr(struct sockaddr_in6 *addr, const unsigned char src[16]) {
    memcpy(&addr->sin6_addr, src, 16);
}

static inline void keel_extract_sockaddr_in6_addr(const struct sockaddr_in6 *addr, unsigned char out[16]) {
    memcpy(out, &addr->sin6_addr, 16);
}

static inline uint16_t keel_sockaddr_in6_port(const struct sockaddr_in6 *addr) {
    return ntohs(addr->sin6_port);
}

static inline uint32_t keel_sockaddr_in6_scope(const struct sockaddr_in6 *addr) {
    return addr->sin6_scope_id;
}

static inline size_t keel_sockaddr_in6_sizeof(void) {
    return sizeof(struct sockaddr_in6);
}

/*
 * sockaddr_storage helpers for getsockname / getpeername where the address
 * family is not known at call time.
 */
static inline size_t keel_sockaddr_storage_sizeof(void) {
    return sizeof(struct sockaddr_storage);
}

/* Returns the sa_family field portably (type differs across platforms). */
static inline int keel_sockaddr_family(const struct sockaddr_storage *sa) {
    return (int)sa->ss_family;
}

/*
 * Extracts the `sun_path` from a sockaddr_un into caller-provided `out`.
 * Writes the raw bytes (including a leading NUL byte for abstract-namespace
 * sockets on Linux) and returns the number of bytes written, or 0 when the
 * address is anonymous (autobind peer socket with no bound path).
 *
 * addrlen is the length returned by getsockname / getpeername / accept. The
 * meaningful portion of sun_path is `addrlen - offsetof(sockaddr_un, sun_path)`.
 */
static int keel_sockaddr_un_copy_path(const struct sockaddr_storage *sa, int addrlen,
                                       unsigned char *out, int out_cap) {
    int header = (int)offsetof(struct sockaddr_un, sun_path);
    if (addrlen <= header) return 0;
    int len = addrlen - header;
    if (len > out_cap) len = out_cap;
    memcpy(out, ((const struct sockaddr_un *)sa)->sun_path, (size_t)len);
    return len;
}

/* ====================================================================
 * EINTR-transparent syscall wrappers.
 *
 * Every blocking / non-blocking socket syscall keel invokes from Kotlin
 * goes through one of these wrappers. The wrappers loop internally on
 * `EINTR` so callers never observe it: a signal delivered to the thread
 * (Kotlin/Native runtime GC safepoints, debugger attach, etc.) restarts
 * the syscall transparently. This is the `TEMP_FAILURE_RETRY` idiom
 * from glibc, applied at the C wrapper layer so every consumer (every
 * engine, every test helper) gets the same behaviour without having to
 * write `if (errno == EINTR) continue` at each call site.
 *
 * `close(2)` is intentionally NOT wrapped here: POSIX leaves the fd
 * state undefined on EINTR, and retrying may close an fd that the
 * kernel silently re-allocated to another open() between calls.
 * Call sites should just invoke `close(2)` directly (or via
 * `closeFdSafely` for the logged variant).
 *
 * All wrappers are `static inline` so the compiler can inline them at
 * the call site — zero cost compared to a direct syscall.
 * ==================================================================== */

static inline ssize_t keel_read(int fd, void *buf, size_t count) {
    ssize_t n;
    do { n = read(fd, buf, count); } while (n < 0 && errno == EINTR);
    return n;
}

static inline ssize_t keel_write(int fd, const void *buf, size_t count) {
    ssize_t n;
    /*
     * Use send(MSG_NOSIGNAL) on Linux so that writing to a peer-closed
     * socket returns EPIPE (WriteResult.Failed) instead of raising
     * SIGPIPE. This is a per-call suppression that does not affect the
     * process-wide signal disposition, unlike signal(SIGPIPE, SIG_IGN).
     *
     * On macOS/BSD, SO_NOSIGPIPE is set per-socket (see keel_set_nosigpipe)
     * so write(2) is used unchanged.
     */
#if defined(__linux__)
    do { n = send(fd, buf, count, MSG_NOSIGNAL); } while (n < 0 && errno == EINTR);
#else
    do { n = write(fd, buf, count); } while (n < 0 && errno == EINTR);
#endif
    return n;
}

static inline int keel_accept(int fd) {
    int r;
    do { r = accept(fd, NULL, NULL); } while (r < 0 && errno == EINTR);
    return r;
}

/*
 * connect(2) is intentionally NOT retried on EINTR.
 *
 * POSIX (Open Group, connect()): "If connect() is interrupted by a
 * signal that is caught while blocked waiting to establish a
 * connection, connect() shall fail and set errno to EINTR, but the
 * connection request shall not be aborted, and the connection shall
 * be established asynchronously."
 *
 * Re-invoking connect() on the same fd after EINTR therefore returns
 * `EALREADY` (handshake in progress) or `EISCONN` (already completed)
 * — never a clean "success". A naive retry loop would surface those
 * to the caller as a generic failure even though the connection is
 * actually fine.
 *
 * The correct POSIX pattern on EINTR is to wait for write-readiness
 * (select / poll / epoll / kevent) and then `getsockopt(SO_ERROR)` to
 * discover the final result — exactly the same flow as `EINPROGRESS`
 * on non-blocking sockets. `PosixNativeSocket.connect` maps both
 * `EINPROGRESS` and `EINTR` to `ConnectResult.InProgress` so the
 * caller's event-loop path handles them identically.
 */
static inline int keel_connect(int fd, const struct sockaddr *addr, socklen_t len) {
    return connect(fd, addr, len);
}

static inline ssize_t keel_send(int fd, const void *buf, size_t count, int flags) {
    ssize_t n;
    do { n = send(fd, buf, count, flags); } while (n < 0 && errno == EINTR);
    return n;
}

static inline int keel_shutdown(int fd, int how) {
    int r;
    do { r = shutdown(fd, how); } while (r < 0 && errno == EINTR);
    return r;
}

/*
 * writev wrapper for gather-write optimization.
 * Accepts parallel arrays of base pointers and lengths, builds
 * iovec internally, and calls writev in a single syscall.
 * Retries transparently on `EINTR` (matches the other `keel_*`
 * wrappers above — callers never need to handle EINTR).
 */
static ssize_t keel_writev(int fd, const void **bases, const size_t *lens, int count) {
    /*
     * Variable-length array, so its size is the caller's `count`. Callers
     * keep that within `keel_iov_max()` because the kernel takes no more --
     * which also bounds this to ~16 KiB of stack. Before that bound existed
     * it grew with the queue.
     */
    struct iovec iov[count];
    for (int i = 0; i < count; i++) {
        iov[i].iov_base = (void *)bases[i];
        iov[i].iov_len = lens[i];
    }
    ssize_t n;
    /*
     * Use sendmsg(MSG_NOSIGNAL) on Linux for the same reason as keel_write:
     * per-call SIGPIPE suppression without touching the process signal mask.
     * sendmsg(2) with an iovec is equivalent to writev(2) for connected
     * stream sockets, with the addition of the MSG_NOSIGNAL flag.
     */
#if defined(__linux__)
    struct msghdr msg;
    memset(&msg, 0, sizeof(msg));
    msg.msg_iov = iov;
    msg.msg_iovlen = (size_t)count;
    do { n = sendmsg(fd, &msg, MSG_NOSIGNAL); } while (n < 0 && errno == EINTR);
#else
    do { n = writev(fd, iov, count); } while (n < 0 && errno == EINTR);
#endif
    return n;
}

/*
 * Thread-safe errno message lookup.
 *
 * strerror(3) is not required to be thread-safe by POSIX and may race on
 * older glibc or non-glibc libc implementations. strerror_r(3) writes to a
 * caller-supplied buffer and is thread-safe, but has two incompatible
 * signatures:
 *   XSI (POSIX): int strerror_r(int, char*, size_t)
 *   GNU:         char *strerror_r(int, char*, size_t)
 *
 * The declaration is selected by feature test macros. Kotlin/Native cinterop
 * for Linux compiles with glibc's XSI variant (no _GNU_SOURCE), so this
 * wrapper targets that. macOS (Darwin) always exposes the XSI form.
 *
 * Returns 0 on success, non-zero on failure.
 */
static int keel_errno_message(int errnum, char *buf, size_t buflen) {
    if (buflen == 0) return -1;
    return strerror_r(errnum, buf, buflen);
}

/*
 * Unix-domain-socket address helpers.
 *
 * `struct sockaddr_un.sun_path` differs in capacity across platforms
 * (108 bytes on Linux, 104 on macOS / BSD), and abstract-namespace
 * sockets (Linux-only) require an exact `addrlen` equal to
 * `offsetof(struct sockaddr_un, sun_path) + 1 + name_len` — no extra
 * NUL byte after the name — while filesystem paths are conventionally
 * bound with the full `sizeof(struct sockaddr_un)`. The helpers below
 * compose the `sockaddr_un` and return the matching `addrlen` so the
 * Kotlin side never has to know about `offsetof` or the per-platform
 * `sun_path` capacity.
 *
 * `keel_bind_un` / `keel_connect_un`:
 *   - `path_len` is the length of `path` in bytes (EXCLUDING any
 *     leading NUL for abstract sockets; the caller passes the raw name
 *     and `is_abstract = 1`).
 *   - `is_abstract`: 1 → Linux abstract namespace (`sun_path[0] = 0`);
 *     0 → filesystem path (null-terminated in `sun_path`).
 *   - Return value: the underlying `bind(2)` / `connect(2)` result
 *     (0 on success, -1 with `errno` set on failure).
 *   - Sets `errno = ENAMETOOLONG` and returns -1 if `path_len` overflows
 *     `sun_path` capacity.
 *
 * `keel_sockaddr_un_max_path` exposes the per-platform `sun_path`
 * capacity so Kotlin can validate at construction time if desired.
 */
static inline size_t keel_sockaddr_un_max_path(void) {
    return sizeof(((struct sockaddr_un *)0)->sun_path);
}

/*
 * Size of `struct sockaddr_un` on the target platform. Lets Kotlin
 * code allocate a correctly-sized byte buffer (`110` on Linux glibc,
 * `106` on macOS) without needing cinterop to bind the struct type —
 * the actual field layout is never touched from Kotlin.
 */
static inline size_t keel_sockaddr_un_sizeof(void) {
    return sizeof(struct sockaddr_un);
}

static int keel_bind_un(int fd, const unsigned char *path, size_t path_len, int is_abstract) {
    struct sockaddr_un sa;
    memset(&sa, 0, sizeof(sa));
    sa.sun_family = AF_UNIX;
    size_t cap = sizeof(sa.sun_path);
    if (is_abstract) {
        /* Linux abstract: sun_path[0] = 0, then raw bytes. No trailing NUL. */
        if (path_len + 1 > cap) { errno = ENAMETOOLONG; return -1; }
        sa.sun_path[0] = '\0';
        if (path_len > 0) memcpy(sa.sun_path + 1, path, path_len);
        socklen_t addrlen = (socklen_t)(offsetof(struct sockaddr_un, sun_path) + 1 + path_len);
        return bind(fd, (struct sockaddr *)&sa, addrlen);
    } else {
        /* Filesystem: null-terminated path inside sun_path, bind with the full struct. */
        if (path_len + 1 > cap) { errno = ENAMETOOLONG; return -1; }
        if (path_len > 0) memcpy(sa.sun_path, path, path_len);
        sa.sun_path[path_len] = '\0';
        return bind(fd, (struct sockaddr *)&sa, sizeof(sa));
    }
}

/* keel_connect_un: matches keel_bind_un shape — see its comment block. */
static int keel_connect_un(int fd, const unsigned char *path, size_t path_len, int is_abstract) {
    struct sockaddr_un sa;
    memset(&sa, 0, sizeof(sa));
    sa.sun_family = AF_UNIX;
    size_t cap = sizeof(sa.sun_path);
    if (is_abstract) {
        if (path_len + 1 > cap) { errno = ENAMETOOLONG; return -1; }
        sa.sun_path[0] = '\0';
        if (path_len > 0) memcpy(sa.sun_path + 1, path, path_len);
        socklen_t addrlen = (socklen_t)(offsetof(struct sockaddr_un, sun_path) + 1 + path_len);
        return connect(fd, (struct sockaddr *)&sa, addrlen);
    } else {
        if (path_len + 1 > cap) { errno = ENAMETOOLONG; return -1; }
        if (path_len > 0) memcpy(sa.sun_path, path, path_len);
        sa.sun_path[path_len] = '\0';
        return connect(fd, (struct sockaddr *)&sa, sizeof(sa));
    }
}

/*
 * Fill a `sockaddr_un` in caller-provided memory for use by io_uring
 * `IORING_OP_CONNECT`, which needs the sockaddr pointer + addrlen
 * directly in the SQE. Returns the addrlen to pass to the SQE, or -1
 * with `errno = ENAMETOOLONG` if the path does not fit.
 */
/*
 * Parameter is `struct sockaddr_storage *` (not `struct sockaddr_un *`)
 * so the signature is ABI-identical across all POSIX platforms and the
 * function can be commonized at the `nativeMain` source set by the
 * Kotlin cinterop commonizer. `sockaddr_storage` is guaranteed to be
 * large enough to hold any `sockaddr_*` variant (RFC 3493).
 */
static int keel_fill_sockaddr_un(struct sockaddr_storage *sa, const unsigned char *path, size_t path_len, int is_abstract) {
    struct sockaddr_un *un = (struct sockaddr_un *)sa;
    memset(un, 0, sizeof(*un));
    un->sun_family = AF_UNIX;
    size_t cap = sizeof(un->sun_path);
    if (is_abstract) {
        if (path_len + 1 > cap) { errno = ENAMETOOLONG; return -1; }
        un->sun_path[0] = '\0';
        if (path_len > 0) memcpy(un->sun_path + 1, path, path_len);
        return (int)(offsetof(struct sockaddr_un, sun_path) + 1 + path_len);
    } else {
        if (path_len + 1 > cap) { errno = ENAMETOOLONG; return -1; }
        if (path_len > 0) memcpy(un->sun_path, path, path_len);
        un->sun_path[path_len] = '\0';
        return (int)sizeof(*un);
    }
}

/*
 * Suppress SIGPIPE on a per-socket basis (macOS/BSD only).
 *
 * SO_NOSIGPIPE prevents write(2)/writev(2) to a peer-closed socket from
 * raising SIGPIPE. Unlike the process-wide signal(SIGPIPE, SIG_IGN), this
 * only affects this specific socket fd, leaving the application's own
 * SIGPIPE handling (e.g. for Unix pipes) intact.
 *
 * Call this on every socket fd right after creation — PosixNativeSocketOps
 * does so inside setNonBlocking(), which is invoked for every socket keel
 * creates or accepts.
 *
 * On Linux, this function is a no-op: SIGPIPE is suppressed per-call via
 * MSG_NOSIGNAL in keel_write / keel_writev instead (SO_NOSIGPIPE is not
 * available on Linux). The no-op body lets PosixNativeSocketOps call it
 * unconditionally on all platforms.
 */
static inline void keel_set_nosigpipe(int fd) {
#if !defined(__linux__)
    int on = 1;
    setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &on, sizeof(on));
#else
    (void)fd;
#endif
}

/*
 * The kernel's per-call limit on `writev` / `sendmsg` iovec entries, as a
 * function because every spelling of it is a macro.
 *
 * The name differs by platform: macOS defines `IOV_MAX` in <limits.h>,
 * glibc leaves that undefined unless a feature-test macro asks for it and
 * defines `UIO_MAXIOV` in <sys/uio.h> instead. Both are 1024 on the hosts
 * this project builds on. `sysconf(_SC_IOV_MAX)` answers on both and is the
 * fallback; POSIX guarantees at least `_XOPEN_IOV_MAX` (16), which is the
 * floor if even sysconf declines.
 *
 * A caller that offers more than this gets a definitive failure with
 * nothing written — indistinguishable at the errno from a genuine argument
 * error, which is why callers bound the batch rather than classify the
 * failure afterwards.
 */
static inline int keel_iov_max(void) {
#if defined(IOV_MAX)
    return IOV_MAX;
#elif defined(UIO_MAXIOV)
    return UIO_MAXIOV;
#else
    long n = sysconf(_SC_IOV_MAX);
    return n > 0 ? (int)n : 16;
#endif
}

/*
 * (Test-only helpers `keel_connect_inet_loopback` / `keel_set_rcvtimeo`
 * were extracted to keel-testing-internal/src/nativeInterop/cinterop/posix_testing.def on
 * 2026-04-23 so that production artifact no longer compiles
 * test-scaffolding C wrappers.)
 */
